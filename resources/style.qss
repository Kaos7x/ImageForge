/* ImageForge dark theme. Dollar-prefixed tokens are substituted by ui/theme.py */

QWidget { color: $text; }
QMainWindow, QDialog, QMessageBox { background: $bg; }
QWidget#Sidebar, QWidget#OptionsRoot { background: $surface; }
QWidget#CenterRoot { background: $bg; }

QToolTip {
    background: $raised; color: $text; border: 1px solid $border_light;
    padding: 5px 8px; border-radius: 4px;
}

/* ---------- labels ---------- */
QLabel#PanelHeader {
    font-size: 11px; font-weight: 700; color: $muted; padding: 14px 16px 8px 16px;
}
QLabel#SectionTitle { font-size: 14px; font-weight: 600; }
QLabel#Caption { color: $muted; font-size: 11px; }
QLabel#Hint { color: $muted; font-size: 11px; }
QLabel#InfoValue { font-weight: 600; font-size: 14px; }
QLabel#StatsLabel { color: $muted; font-size: 12px; }
QLabel#EstimateLabel { color: $accent; font-weight: 600; }
QLabel#ExampleLabel { color: $muted; font-size: 11px; }
QLabel#WarnLabel { color: $warning; font-size: 11px; }
QLabel#ViewerOverlay {
    background: rgba(15, 17, 21, 215); color: $text; border: 1px solid $border_light;
    border-radius: 8px; padding: 8px 14px;
}
QLabel#ViewerHint {
    background: rgba(15, 17, 21, 175); color: $muted; border-radius: 7px;
    padding: 4px 11px; font-size: 11px;
}
QLabel#BgPreview {
    background: $input; border: 1px solid $border; border-radius: 8px; color: $muted;
}
QLabel#ModelDot {
    min-width: 10px; max-width: 10px; min-height: 10px; max-height: 10px;
    border-radius: 5px; background: $muted_dim;
}
QLabel#ModelDot[state="ready"] { background: $success; }
QLabel#ModelDot[state="loading"] { background: $warning; }
QLabel#ModelDot[state="error"] { background: $danger; }
QLabel#ModelDot[state="unavailable"] { background: $danger; }

/* ---------- buttons ---------- */
QPushButton {
    background: $raised; border: 1px solid $border; border-radius: 7px; padding: 7px 12px;
}
QPushButton:hover { background: $raised_hover; border-color: $border_light; }
QPushButton:pressed { background: $surface; }
QPushButton:disabled { color: $muted_dim; background: $surface; border-color: $border; }
QPushButton:focus { border-color: $accent; }

QPushButton[variant="primary"] {
    background: $accent; border: 1px solid $accent; color: $accent_text; font-weight: 700;
}
QPushButton[variant="primary"]:hover { background: $accent_hover; border-color: $accent_hover; }
QPushButton[variant="primary"]:pressed { background: $accent_pressed; }
QPushButton[variant="primary"]:disabled {
    background: $accent_disabled; border-color: $accent_disabled; color: $muted_dim;
}
QPushButton[variant="danger"]:hover { border-color: $danger; color: $danger; }
QPushButton[variant="link"] {
    background: transparent; border: none; color: $muted; padding: 2px 6px;
}
QPushButton[variant="link"]:hover { color: $accent; background: transparent; }

QPushButton[segment="true"] {
    background: $input; border: 1px solid $border; border-radius: 0; padding: 6px 18px;
}
QPushButton[segmentPos="left"] { border-top-left-radius: 7px; border-bottom-left-radius: 7px; }
QPushButton[segmentPos="right"] { border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-left: none; }
QPushButton[segment="true"]:checked { background: $accent; border-color: $accent; color: $accent_text; font-weight: 700; }

QPushButton[tool="true"] { padding: 5px 10px; min-width: 18px; }

/* ---------- inputs ---------- */
QLineEdit, QSpinBox {
    background: $input; border: 1px solid $border; border-radius: 7px; padding: 6px 8px;
    selection-background-color: $accent; selection-color: $accent_text;
}
QComboBox {
    background: $input; border: 1px solid $border; border-radius: 7px; padding: 6px 28px 6px 8px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: $accent; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: $muted_dim; }
QLineEdit[readOnly="true"] { color: $muted; }

QComboBox::drop-down { border: none; width: 24px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url("$arrow_down"); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background: $raised; border: 1px solid $border_light; outline: none;
    selection-background-color: $accent_dim; selection-color: $text; padding: 4px;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 18px; border: none; background: transparent; subcontrol-origin: border;
}
QSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow { image: url("$arrow_up"); width: 12px; height: 12px; }
QSpinBox::down-arrow { image: url("$arrow_down"); width: 12px; height: 12px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 4px; border: 1px solid $border_light; background: $input;
}
QCheckBox::indicator:hover { border-color: $accent; }
QCheckBox::indicator:checked { background: $accent; border-color: $accent; image: url("$check"); }
QCheckBox::indicator:disabled { background: $surface; border-color: $border; }
QCheckBox:disabled { color: $muted_dim; }
QCheckBox#SectionToggle { font-size: 14px; font-weight: 600; }

QRadioButton { spacing: 7px; }
QRadioButton::indicator {
    width: 14px; height: 14px; border-radius: 8px; border: 1px solid $border_light; background: $input;
}
QRadioButton::indicator:hover { border-color: $accent; }
QRadioButton::indicator:checked {
    border: 1px solid $accent;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 $accent, stop:0.5 $accent, stop:0.56 $input, stop:1 $input);
}
QRadioButton:disabled { color: $muted_dim; }

QSlider::groove:horizontal { height: 4px; background: $border; border-radius: 2px; }
QSlider::sub-page:horizontal { background: $accent; border-radius: 2px; }
QSlider::handle:horizontal {
    background: $text; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: $accent_hover; }
QSlider::sub-page:horizontal:disabled { background: $muted_dim; }

QProgressBar {
    background: $input; border: 1px solid $border; border-radius: 6px; text-align: center;
    min-height: 16px; max-height: 16px; font-size: 11px;
}
QProgressBar::chunk { background: $accent; border-radius: 5px; }

/* ---------- containers ---------- */
QFrame#SectionCard { background: $raised; border: 1px solid $border; border-radius: 12px; }
QFrame#DropZone { background: $bg; border: 2px dashed $border_light; border-radius: 12px; }
QFrame#DropZone:hover, QFrame#DropZone[dragActive="true"] {
    border-color: $accent; background: $accent_faint;
}
QFrame#InfoBar { background: $surface; border-top: 1px solid $border; }
QFrame#Toolbar { background: $surface; border-bottom: 1px solid $border; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QWidget#OptionsContent { background: transparent; }

QListWidget#ImageList {
    background: $bg; border: 1px solid $border; border-radius: 10px; padding: 4px; outline: none;
}
QListWidget#ImageList::item { padding: 6px; border-radius: 8px; margin: 1px 0; border: 1px solid transparent; }
QListWidget#ImageList::item:hover { background: $raised; }
QListWidget#ImageList::item:selected { background: $accent_dim; border: 1px solid $accent; color: $text; }

QGraphicsView { background: $bg; border: none; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: $border_light; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: $muted_dim; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: $border_light; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: $muted_dim; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QSplitter::handle { background: $border; }
QSplitter::handle:horizontal { width: 1px; }

/* ---------- menus & status bar ---------- */
QMenuBar { background: $surface; border-bottom: 1px solid $border; padding: 2px; }
QMenuBar::item { padding: 5px 10px; border-radius: 5px; background: transparent; }
QMenuBar::item:selected { background: $raised_hover; }
QMenu { background: $raised; border: 1px solid $border_light; padding: 5px; }
QMenu::item { padding: 6px 26px 6px 14px; border-radius: 5px; }
QMenu::item:selected { background: $accent_dim; }
QMenu::item:disabled { color: $muted_dim; }
QMenu::separator { height: 1px; background: $border; margin: 4px 8px; }
QStatusBar { background: $surface; border-top: 1px solid $border; color: $muted; }
QStatusBar::item { border: none; }

QMessageBox QLabel { color: $text; }
QTextEdit, QPlainTextEdit {
    background: $input; border: 1px solid $border; border-radius: 7px; color: $text;
}
